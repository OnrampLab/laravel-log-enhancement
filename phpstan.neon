includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - src

    # The level 8 is the highest level
    level: 0

    # ignoreErrors:
    #    - '#Unsafe usage of new static#'

    excludePaths:
        - ./*/*/Tests/*.php
        - ./*/*/factories/*.php
        - ./*/*/Migrations/*.php
